{
  "title": "Сумма и разность через указатели",
  "order": 3,
  "hint": "a и b — обычные значения, а sum и diff — адреса. Записывать нужно через *: *sum = a + b;",
  "tests": [
    {
      "input": "7 3\n",
      "output": "10\n4\n"
    },
    {
      "input": "3 7\n",
      "output": "10\n-4\n"
    },
    {
      "input": "0 0\n",
      "output": "0\n0\n"
    },
    {
      "input": "-5 -5\n",
      "output": "-10\n0\n"
    },
    {
      "input": "100000000 -100000000\n",
      "output": "0\n200000000\n"
    },
    {
      "input": "-100000000 100000000\n",
      "output": "0\n-200000000\n"
    }
  ]
}
