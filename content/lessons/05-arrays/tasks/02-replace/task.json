{
  "title": "Замена элемента",
  "order": 2,
  "hint": "После ввода массива — ещё два scanf для k и v, затем numbers[k] = v; и цикл вывода.",
  "tests": [
    {
      "input": "10 20 30 40 50 1 100\n",
      "output": "10\n100\n30\n40\n50\n"
    },
    {
      "input": "1 2 3 4 5 0 -7\n",
      "output": "-7\n2\n3\n4\n5\n"
    },
    {
      "input": "1 2 3 4 5 4 99\n",
      "output": "1\n2\n3\n4\n99\n"
    },
    {
      "input": "5 5 5 5 5 2 5\n",
      "output": "5\n5\n5\n5\n5\n"
    },
    {
      "input": "0 0 0 0 0 3 -100000000\n",
      "output": "0\n0\n0\n-100000000\n0\n"
    }
  ]
}
