{
  "title": "Сумма и максимум",
  "order": 3,
  "hint": "Максимум начинай с numbers[0], а не с 0 — иначе ответ будет неверным, если все числа отрицательные.",
  "tests": [
    {
      "input": "1 2 3 4 5\n",
      "output": "15\n5\n"
    },
    {
      "input": "5 4 3 2 1\n",
      "output": "15\n5\n"
    },
    {
      "input": "-5 -2 -9 -1 -7\n",
      "output": "-24\n-1\n"
    },
    {
      "input": "7 7 7 7 7\n",
      "output": "35\n7\n"
    },
    {
      "input": "0 0 0 0 0\n",
      "output": "0\n0\n"
    },
    {
      "input": "100000000 -100000000 100000000 -100000000 100000000\n",
      "output": "100000000\n100000000\n"
    }
  ]
}
