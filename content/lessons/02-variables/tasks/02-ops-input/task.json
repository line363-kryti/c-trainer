{
  "title": "Пять операций с вводом",
  "order": 2,
  "hint": "Два вызова scanf(\"%d\", &...) — по одному на каждое число. Пробел между числами scanf пропустит сам.",
  "tests": [
    {
      "input": "10 3\n",
      "output": "13\n7\n30\n3\n1\n"
    },
    {
      "input": "7 7\n",
      "output": "14\n0\n49\n1\n0\n"
    },
    {
      "input": "0 5\n",
      "output": "5\n-5\n0\n0\n0\n"
    },
    {
      "input": "5 10\n",
      "output": "15\n-5\n50\n0\n5\n"
    },
    {
      "input": "10000 1\n",
      "output": "10001\n9999\n10000\n10000\n0\n"
    },
    {
      "input": "9999 10000\n",
      "output": "19999\n-1\n99990000\n0\n9999\n"
    }
  ]
}
