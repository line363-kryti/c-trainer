# Скопируй этот файл в .env и поменяй значения. Файл .env не коммитится.

# База данных (контейнер Postgres создаст пользователя и базу с этими данными)
POSTGRES_USER=ctrainer
# Пароль: только латиница и цифры, без @ : / #
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ctrainer

# Адрес базы для запуска БЕЗ докера (тесты, alembic с компьютера).
# Внутри docker-compose адрес собирается сам из трёх строк выше.
DATABASE_URL=postgresql+psycopg://ctrainer:change_me@localhost:5432/ctrainer

# Секрет для подписи JWT. Длинная случайная строка, минимум 32 символа.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# На хостинге с https поставить true, локально false
COOKIE_SECURE=false

# Чем запускать код: piston (свой контейнер, по умолчанию) или judge0 (RapidAPI, нужен ключ)
RUNNER=piston

# Нужно только при RUNNER=judge0
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_KEY=
